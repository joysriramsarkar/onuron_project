---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import Hero from "@onuron/ui/components/Hero.astro";
import CodeBlock from "@onuron/ui/components/CodeBlock.astro";
---

<BaseLayout
  title="মোবাইল ইনস্টলেশন গাইড — onuronOS Fastboot Flashing & Simulator Setup"
  description="onuronOS মোবাইল ওএস ইনস্টলেশন নির্দেশিকা — স্মার্টফোনে ফাস্টবুট (Fastboot) ফ্ল্যাশিং এবং পিসিতে ভার্চুয়াল মোবাইল সিমুলেটর সেটআপ।"
>
  <Navbar current="onuronOS" />

  <!-- Ambient Glow Orbs -->
  <div class="ambient-glow ambient-blue" style="top: -60px; left: 15%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-purple" style="top: 300px; right: 5%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-teal" style="top: 900px; left: 5%;" aria-hidden="true"></div>

  <Hero
    title="onuronOS মোবাইল ইনস্টলেশন গাইড"
    subtitle="স্মার্টফোনে ফাস্টবুট (Fastboot) এর মাধ্যমে বুট ইমেজ ফ্ল্যাশিং অথবা পিসিতে মোবাইল সিমুলেটরে টেস্ট করার সম্পূর্ণ গাইড।"
    eyebrow="✦ OnePlus 6T Fastboot Flashing · QEMU Mobile Simulator · Galaxy S25 Lab"
  >
    <a class="btn btn-primary btn-glow" href="#fastboot-steps">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
        <line x1="12" y1="18" x2="12.01" y2="18"></line>
      </svg>
      ফোনে ফাস্টবুট ফ্ল্যাশিং
    </a>
    <a class="btn btn-ghost" href="#sim-steps">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      পিসিতে মোবাইল সিমুলেটর
    </a>
  </Hero>

  <div class="divider"></div>

  <main style="position: relative; z-index: 1;">
    <!-- SECTION 1: PHYSICAL SMARTPHONE FASTBOOT FLASHING -->
    <section id="fastboot-steps" class="section container" style="max-width: 900px;">
      <div style="text-align: center; margin-bottom: 48px;">
        <span class="badge" style="background: rgba(79,139,249,0.15); color: var(--accent); margin-bottom: 12px; display: inline-block;">
          PHYSICAL PHONE TARGET
        </span>
        <h2 class="anim-heading">স্মার্টফোনে ফাস্টবুট ফ্ল্যাশিং (OnePlus 6T / fajita)</h2>
        <p class="muted">
          মোবাইল ফোনে কোনো বায়োস বা সাধারণ পিসির মতো বুটেবল পেনড্রাইভ ব্যবহার করা হয় না। অ্যান্ড্রয়েড ফাস্টবুট প্রোটোকল দিয়ে সরাসরি পার্টিশনে কার্নেল ও সিস্টেম রাইট করা হয়।
        </p>
      </div>

      <div class="steps-flow">
        <!-- STEP 1 -->
        <div class="step-card glass-card reveal-left">
          <div class="step-marker">
            <span class="step-number">০১</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-badge">STEP 1 • FASTBOOT PREPARATION</div>
            <h3 class="step-title">বুটলোডার আনলক ও ফাস্টবুট মোডে রিবুট</h3>
            <p class="muted">
              ফোনে ডেভেলপার অপশন থেকে <strong>OEM Unlocking</strong> চালু করুন। এরপর ফোনটি USB ক্যাবল দিয়ে কম্পিউটারের সাথে যুক্ত করে ফাস্টবুট মোডে নিন:
            </p>

            <div class="code-wrap">
              <div class="code-title">Terminal:</div>
              <CodeBlock label="$" code="adb reboot bootloader" />
            </div>

            <p class="small muted" style="margin-top: 12px;">
              ডিভাইস কানেকশন যাচাই করতে টার্মিনালে নিচের কমান্ড দিন:
            </p>
            <CodeBlock label="$" code="fastboot devices" />
          </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-card glass-card reveal-left">
          <div class="step-marker">
            <span class="step-number">০২</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-badge">STEP 2 • VBMETA ROOT OF TRUST</div>
            <h3 class="step-title">ক্রিপ্টোগ্রাফিক vbmeta ইমেজ ফ্ল্যাশ</h3>
            <p class="muted">
              onuronOS-এর <code class="mono">mkvbmeta.py</code> টুল দ্বারা উৎপাদিত Ed25519 সিকিউরিটি মেটাডেটা ফ্ল্যাশ করে ভেরিফাইড বুট সমন্বয় করুন:
            </p>

            <div class="code-wrap">
              <CodeBlock label="$" code="fastboot --disable-verity --disable-verification flash vbmeta vbmeta.img" />
            </div>

            <div class="tip-box">
              <span class="tip-icon">🔒</span>
              <p>এটি কার্নেল ও পার্টিশন ইন্টিগ্রিটি লককে onuronOS কার্নেল ট্রির সাথে পেয়ার করে।</p>
            </div>
          </div>
        </div>

        <!-- STEP 3 -->
        <div class="step-card glass-card reveal-left">
          <div class="step-marker">
            <span class="step-number">০৩</span>
            <div class="step-line"></div>
          </div>
          <div class="step-content">
            <div class="step-badge">STEP 3 • FLASH SYSTEM & BOOT</div>
            <h3 class="step-title">কার্নেল (boot.img) ও সিস্টেম পার্টিশন ফ্ল্যাশিং</h3>
            <p class="muted">
              অনুরণ ওএস লিনাক্স কার্নেল ও Rust nilinit সম্বলিত <code class="mono">boot.img</code> এবং ফাইলসিস্টেম সম্বলিত <code class="mono">super.img</code> ফ্ল্যাশ করুন:
            </p>

            <div class="code-wrap">
              <CodeBlock label="$" code="fastboot flash boot boot.img && fastboot flash super super.img" />
            </div>

            <div class="code-wrap" style="margin-top: 14px;">
              <div class="code-title">সবশেষে ফোন রিবুট করুন:</div>
              <CodeBlock label="$" code="fastboot reboot" />
            </div>
          </div>
        </div>

        <!-- STEP 4 -->
        <div class="step-card glass-card reveal-left">
          <div class="step-marker">
            <span class="step-number">০৪</span>
          </div>
          <div class="step-content">
            <div class="step-badge">STEP 4 • FIRST BOOT & OOBE</div>
            <h3 class="step-title">টাচস্ক্রিন OOBE সেটআপ ও আলপ লঞ্চার</h3>
            <p class="muted">
              ফোন রিবুট হওয়ার কয়েক সেকেন্ডের মধ্যে onuronOS-এর 120Hz/60Hz NilHAL মোবাইল ইন্টারফেস লোড হবে:
            </p>

            <div class="features-checklist glass-panel">
              <div class="check-item">
                <span class="check-icon">✓</span>
                <div>
                  <strong>OOBE Setup:</strong> টাচস্ক্রিনে নাম এবং নিরাপদ পিন (PIN) কোড সেট করুন।
                </div>
              </div>
              <div class="check-item">
                <span class="check-icon">✓</span>
                <div>
                  <strong>Mobile Apps Ready:</strong> ফোন ডায়ালার (Phone), মেসেজিং (SMS), ক্যালকুলেটর ও নোটস অ্যাপস সরাসরি প্রস্তুত।
                </div>
              </div>
              <div class="check-item">
                <span class="check-icon">✓</span>
                <div>
                  <strong>Android Container:</strong> কন্টেইনারাইজড ব্যাকগ্রাউন্ডে হোয়াটসঅ্যাপ বা ব্যাংকিং অ্যাপস রান করার আইসোলেটেড পরিবেশ।
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: PC MOBILE SIMULATOR SETUP -->
    <section id="sim-steps" class="section-sm container" style="max-width: 900px;">
      <div class="glass-panel" style="padding: 40px 36px; border-radius: 24px;">
        <span class="badge" style="background: rgba(16,229,178,0.15); color: var(--accent-2); margin-bottom: 12px; display: inline-block;">
          ZERO-RISK TESTING
        </span>
        <h2 style="margin: 0 0 12px; font-size: 1.8rem;">পিসিতে ভার্চুয়াল মোবাইল সিমুলেটর চালানো</h2>
        <p class="muted" style="margin-bottom: 24px;">
          কোনো আসল স্মার্টফোনে ফ্ল্যাশ করার কোনো প্রয়োজন নেই! আপনার Windows বা Linux পিসিতে ভার্চুয়াল টাচস্ক্রিন ফোন হিসেবে onuronOS উপভোগ করতে পারেন:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 28px;">
          <div class="glass-card" style="padding: 20px; border-radius: 16px;">
            <h4 style="margin: 0 0 8px; color: var(--accent);">Windows ব্যবহারকারী:</h4>
            <p class="small muted" style="margin-bottom: 12px;">ডাউনলোড করা সিমুলেটর জিপ আনজিপ করে সরাসরি রান করুন:</p>
            <CodeBlock label="CMD>" code="run-simulator.bat" />
          </div>

          <div class="glass-card" style="padding: 20px; border-radius: 16px;">
            <h4 style="margin: 0 0 8px; color: var(--accent-2);">Linux / macOS ব্যবহারকারী:</h4>
            <p class="small muted" style="margin-bottom: 12px;">টার্মিনালে QEMU মোবাইল টার্গেট এক্সিকিউট করুন:</p>
            <CodeBlock label="$" code="./build/qemu-boot.sh --target=qemu-x86_64" />
          </div>
        </div>

        <div style="display: flex; gap: 16px; justify-content: flex-end; flex-wrap: wrap;">
          <a class="btn btn-primary" href="/download#releases">মোবাইল রিলিজ ডাউনলোড করুন →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin: 20px auto 40px;
  }

  .step-card {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 24px;
    padding: 36px 32px;
    border-radius: 24px;
    position: relative;
  }

  @media (max-width: 640px) {
    .step-card {
      grid-template-columns: 1fr;
      padding: 24px 18px;
      gap: 16px;
    }
  }

  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-number {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: rgba(79, 139, 249, 0.15);
    border: 1px solid rgba(79, 139, 249, 0.4);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 800;
    font-family: var(--mono);
    box-shadow: 0 0 25px rgba(79, 139, 249, 0.25);
  }

  .step-line {
    width: 2px;
    flex-grow: 1;
    background: linear-gradient(180deg, rgba(79, 139, 249, 0.5), rgba(16, 229, 178, 0.2));
    margin-top: 16px;
    border-radius: 2px;
  }

  .step-badge {
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-2);
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .step-title {
    font-size: 1.5rem;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .code-wrap {
    margin-top: 14px;
  }

  .code-title {
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--mono);
    margin-bottom: 6px;
  }

  .tip-box {
    margin-top: 16px;
    background: rgba(16, 229, 178, 0.08);
    border: 1px solid rgba(16, 229, 178, 0.3);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 0.88rem;
  }

  .tip-box p {
    margin: 0;
    color: #e2e8f0;
  }

  .features-checklist {
    padding: 20px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
  }

  .check-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.92rem;
    color: #e2e8f0;
  }

  .check-icon {
    color: var(--accent-2);
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  /* ── LIGHT MODE STYLING ── */
  :global([data-theme="light"]) .step-card {
    background: #ffffff !important;
    border-color: rgba(226, 232, 240, 0.95) !important;
    box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05) !important;
  }
  :global([data-theme="light"]) .step-number {
    background: rgba(37, 99, 235, 0.08) !important;
    border-color: rgba(37, 99, 235, 0.3) !important;
    color: #2563eb !important;
  }
  :global([data-theme="light"]) .step-title {
    color: #0f172a !important;
  }
  :global([data-theme="light"]) .tip-box {
    background: #f0fdf4 !important;
    border-color: rgba(187, 247, 208, 0.9) !important;
  }
  :global([data-theme="light"]) .tip-box p {
    color: #166534 !important;
  }
  :global([data-theme="light"]) .check-item {
    color: #1e293b !important;
  }
</style>
