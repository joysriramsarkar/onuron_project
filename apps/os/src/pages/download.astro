---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import Hero from "@onuron/ui/components/Hero.astro";
import CodeBlock from "@onuron/ui/components/CodeBlock.astro";
---

<BaseLayout
  title="onuronOS মোবাইল রিলিজ — Fastboot Images & Mobile Simulators"
  description="স্মার্টফোনের জন্য onuronOS v1.0 মোবাইল ওএস রিলিজ — OnePlus 6T ফাস্টবুট ইমেজ, QEMU/Nilsim মোবাইল সিমুলেটর ও অ্যান্ড্রয়েড হোস্ট রানটাইম।"
>
  <Navbar current="onuronOS" />

  <!-- Ambient Glow Orbs -->
  <div class="ambient-glow ambient-blue" style="top: -80px; left: 10%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-purple" style="top: 250px; right: 5%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-teal" style="top: 800px; left: 5%;" aria-hidden="true"></div>

  <Hero
    title="onuronOS মোবাইল রিলিজ"
    subtitle="স্মার্টফোনের জন্য ১০০% Rust-নির্মিত সার্বভৌম মোবাইল অপারেটিং সিস্টেম — ফিজিক্যাল ফোনের ফাস্টবুট ইমেজ, পিসির জন্য মোবাইল সিমুলেটর এবং অ্যান্ড্রয়েড হোস্ট ল্যাব রানটাইম।"
    eyebrow="✦ onuronOS Mobile v1.0 · Fastboot Flashable · 100% Rust PID 1 nilinit"
  >
    <a class="btn btn-primary btn-glow" href="#releases">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
        <line x1="12" y1="18" x2="12.01" y2="18"></line>
      </svg>
      মোবাইল টার্গেট সিলেক্ট করুন
    </a>
    <a class="btn btn-ghost" href="/install">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
      </svg>
      ফাস্টবুট ফ্ল্যাশিং গাইড →
    </a>
  </Hero>

  <div class="divider"></div>

  <main style="position: relative; z-index: 1;">
    <!-- OFFICIAL MOBILE RELEASES GRID -->
    <section id="releases" class="section container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 56px auto;">
        <p class="section-eyebrow reveal">Official Mobile Builds</p>
        <h2 class="anim-heading">মোবাইল প্ল্যাটফর্ম প্যাকেজ</h2>
        <p class="muted reveal" data-delay="1">
          অনুরণ মোবাইল ওএস কোনো ডেস্কটপ ওএস নয় — এটি স্মার্টফোনের টাচস্ক্রিন, কলিং, মেসেজিং ও অ্যাপস চালানোর জন্য তৈরি।
        </p>
      </div>

      <div class="downloads-grid gsap-stagger">
        <!-- Target 1: Physical Phone Fastboot Target (OnePlus 6T) -->
        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-blue">oneplus-fajita</span>
            <span class="status-pill">PHYSICAL SMARTPHONE</span>
          </div>

          <div class="download-icon-wrap icon-blue">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>

          <h3 class="download-title">OnePlus 6T Fastboot ROM</h3>
          <p class="download-desc">
            Snapdragon 845 সম্পন্ন OnePlus 6T স্মার্টফোনের জন্য সরাসরি ফাস্টবুট-ফ্ল্যাশযোগ্য পূর্ণাঙ্গ সিস্টেম ইমেজ প্যাকেজ (boot.img, super.img, vbmeta.img)।
          </p>

          <div class="spec-matrix">
            <div class="spec-row">
              <span class="spec-key">টার্গেট ডিভাইস:</span>
              <span class="spec-val">OnePlus 6T (fajita)</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">প্যাকেজ ফাইল:</span>
              <span class="spec-val mono">boot.img + super.img</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">প্যাকেজ সাইজ:</span>
              <span class="spec-val mono">~480 MB</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">সিকিউরিটি:</span>
              <span class="spec-val text-accent-2">mkvbmeta Ed25519 Verified</span>
            </div>
          </div>

          <div class="download-action-group">
            <a class="btn btn-primary btn-glow download-btn" href="https://cdn.onuron.org/os/onuronos-1.0.0-fajita-fastboot.zip">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Fastboot Zip ডাউনলোড (480 MB)</span>
            </a>
            <div class="mirror-links">
              <a href="/install#fastboot-steps" class="mirror-link">ফ্ল্যাশিং গাইড ↗</a>
              <span class="dot-sep">•</span>
              <a href="https://cdn.onuron.org/os/onuronos-1.0.0-fajita.sig" class="mirror-link">Ed25519 Sig ↗</a>
            </div>
          </div>

          <div class="hash-box">
            <div class="hash-label">
              <span>SHA-256 Checksum</span>
              <button class="copy-hash-btn" data-hash="a89f928e44ef182a4d31065c71b69fba7532408ec202d6b38c35ff51f4967381">কপি</button>
            </div>
            <code class="hash-code">a89f928e44ef182a4d31065c71b69fba7532408ec202d6b38c35ff51f4967381</code>
          </div>
        </div>

        <!-- Target 2: QEMU & Nilsim Mobile Simulator -->
        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-purple">qemu-simulator</span>
            <span class="status-pill status-arm">PC SIMULATOR</span>
          </div>

          <div class="download-icon-wrap icon-purple">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>

          <h3 class="download-title">QEMU & Nilsim মোবাইল সিমুলেটর</h3>
          <p class="download-desc">
            কোনো ফোন ফ্ল্যাশ করার ঝামেলা ছাড়াই Windows / Linux পিসিতে বসে সরাসরি ভার্চুয়াল টাচস্ক্রিন ফোন, ডায়ালার, লকস্ক্রিন ও Alap অ্যাপস টেস্ট করার সিমুলেটর।
          </p>

          <div class="spec-matrix">
            <div class="spec-row">
              <span class="spec-key">প্ল্যাটফর্ম:</span>
              <span class="spec-val">Windows / Linux / macOS</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">ডিসপ্লে রানটাইম:</span>
              <span class="spec-val mono">NilHAL 60FPS Touchscreen</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">বান্ডল সাইজ:</span>
              <span class="spec-val mono">~240 MB</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">রান কমান্ড:</span>
              <span class="spec-val text-accent-2">./run-simulator.bat</span>
            </div>
          </div>

          <div class="download-action-group">
            <a class="btn btn-primary btn-glow download-btn" href="https://cdn.onuron.org/os/onuronos-mobile-simulator-v1.0.zip">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Simulator Zip ডাউনলোড (240 MB)</span>
            </a>
            <div class="mirror-links">
              <a href="/install#sim-steps" class="mirror-link">সিমুলেটর গাইড ↗</a>
              <span class="dot-sep">•</span>
              <a href="https://github.com/joysriramsarkar/nilos-emulator" target="_blank" class="mirror-link">nilos-emulator ↗</a>
            </div>
          </div>

          <div class="hash-box">
            <div class="hash-label">
              <span>SHA-256 Checksum</span>
              <button class="copy-hash-btn" data-hash="5c898c6d1d28362d22b0715cf485e903a4b60b71d9f82d02c77b73273e351f04">কপি</button>
            </div>
            <code class="hash-code">5c898c6d1d28362d22b0715cf485e903a4b60b71d9f82d02c77b73273e351f04</code>
          </div>
        </div>

        <!-- Target 3: Android Host Companion Lab -->
        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-teal">android-host-arm64</span>
            <span class="status-pill">ANDROID HOST LAB</span>
          </div>

          <div class="download-icon-wrap icon-teal">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 10a8 8 0 0 1 16 0v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-7z"></path>
              <line x1="8" y1="3" x2="10" y2="6"></line>
              <line x1="16" y1="3" x2="14" y2="6"></line>
            </svg>
          </div>

          <h3 class="download-title">Galaxy S25 Host Lab APK</h3>
          <p class="download-desc">
            Samsung Galaxy S25 (Snapdragon 8 Elite) ও ফ্ল্যাগশিপ অ্যান্ড্রয়েড ডিভাইসে সরাসরি NDK/JNI 120Hz AMOLED ডিসপ্লেতে onuronOS ইউজারস্পেস ও Alap অ্যাপ টেস্ট করুন।
          </p>

          <div class="spec-matrix">
            <div class="spec-row">
              <span class="spec-key">টার্গেট:</span>
              <span class="spec-val">Samsung Galaxy S25 / ARM64</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">প্যাকেজ ফরম্যাট:</span>
              <span class="spec-val mono">Standalone Android APK</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">সাইজ:</span>
              <span class="spec-val mono">~45 MB</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">রানটাইম:</span>
              <span class="spec-val text-accent-2">120Hz Alap Reactive Engine</span>
            </div>
          </div>

          <div class="download-action-group">
            <a class="btn btn-primary btn-glow download-btn" href="https://cdn.onuron.org/os/onuron-host-s25.apk">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Host APK ডাউনলোড (45 MB)</span>
            </a>
          </div>

          <div class="hash-box">
            <div class="hash-label">
              <span>SHA-256 Checksum</span>
              <button class="copy-hash-btn" data-hash="8f9024c16a8d7950c441b8a3e7ef99238e83b0f51940982df4c297782b3d11b2">কপি</button>
            </div>
            <code class="hash-code">8f9024c16a8d7950c441b8a3e7ef99238e83b0f51940982df4c297782b3d11b2</code>
          </div>
        </div>

        <!-- Target 4: Source Build Toolchain -->
        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-purple">source-build</span>
            <span class="status-pill">DEV TOOLCHAIN</span>
          </div>

          <div class="download-icon-wrap icon-purple">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>

          <h3 class="download-title">Source Tree & Build Tools</h3>
          <p class="download-desc">
            GitHub থেকে সম্পূর্ণ সোর্স কোড ক্লোন করে নিজস্ব কার্নেল, `mkbootimg.py`, `mkvbmeta.py` এবং Rust `nilinit` সহ সরাসরি কাস্টম মোবাইল ইমেজ বিল্ড করুন।
          </p>

          <div class="spec-matrix">
            <div class="spec-row">
              <span class="spec-key">বিল্ড স্ক্রিপ্ট:</span>
              <span class="spec-val mono">python3 build/build.py</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">রিকয়ারমেন্ট:</span>
              <span class="spec-val">Rust, Python 3.10+, Cargo</span>
            </div>
            <div class="spec-row">
              <span class="spec-key">টার্গেট ভ্যালিডেশন:</span>
              <span class="spec-val text-accent-2">Fail-Closed Safety Gates</span>
            </div>
          </div>

          <div class="download-action-group">
            <a class="btn btn-ghost download-btn" href="https://github.com/joysriramsarkar/onuronOS" target="_blank" rel="noreferrer">
              <span>GitHub রিপোজিটরি ওপেন করুন ↗</span>
            </a>
          </div>

          <div class="hash-box">
            <div class="hash-label">
              <span>Quick Clone</span>
            </div>
            <code class="hash-code">git clone https://github.com/joysriramsarkar/onuronOS.git</code>
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE SYSTEM ARCHITECTURE HIGHLIGHT -->
    <section class="section-sm container" style="max-width: 860px;">
      <div class="glass-panel" style="padding: 36px 32px; border-radius: 20px;">
        <h3 style="margin: 0 0 16px; font-size: 1.5rem;">অনুরণ ওএস কীভাবে মোবাইল ফোনে কাজ করে?</h3>
        <p class="muted" style="line-height: 1.7; margin-bottom: 20px;">
          স্মার্টফোনে কোনো সাধারণ পিসির মতো বায়োস থাকে না। অনুরণ ওএস তৈরি করা হয়েছে বিশেষ মোবাইল বুট আর্কিটেকচারে:
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px;">
          <div class="glass-card" style="padding: 18px; border-radius: 14px;">
            <h4 style="margin: 0 0 6px; color: var(--accent);">📱 টাচস্ক্রিন NilHAL</h4>
            <p class="small muted" style="margin: 0;">Linux evdev ও সরাসরি DRM/KMS ফ্রেমবাফারে 120Hz/60Hz স্মুথ জেসচার ও টাচ রেসপন্স।</p>
          </div>
          <div class="glass-card" style="padding: 18px; border-radius: 14px;">
            <h4 style="margin: 0 0 6px; color: var(--accent-2);">⚡ Rust PID 1 Init</h4>
            <p class="small muted" style="margin: 0;">`nilinit` মেমরি নিরাপদ ও কয়েকশো মিলিসেকেন্ডে মোবাইল সার্ভিসেস ও ডিমন্স সক্রিয় করে।</p>
          </div>
          <div class="glass-card" style="padding: 18px; border-radius: 14px;">
            <h4 style="margin: 0 0 6px; color: #c084fc;">🤝 কন্টেইনার অ্যান্ড্রয়েড</h4>
            <p class="small muted" style="margin: 0;">আপনার প্রয়োজনীয় অ্যান্ড্রয়েড অ্যাপস নিরাপদে আইসোলেটেড কন্টেইনারে চলার সুবিধা।</p>
          </div>
        </div>

        <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid rgba(46,64,120,0.3); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <span class="small muted">ফাস্টবুট মোডে ফোন ফ্ল্যাশ করার নির্দেশিকা:</span>
          <a class="btn btn-primary small" href="/install">ফাস্টবুট ফ্ল্যাশিং গাইড দেখুন →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll(".copy-hash-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const hash = (btn as HTMLElement).dataset.hash;
      if (hash) {
        navigator.clipboard.writeText(hash).then(() => {
          const original = btn.textContent;
          btn.textContent = "✓ কপিড!";
          (btn as HTMLElement).style.background = "rgba(16,229,178,0.3)";
          (btn as HTMLElement).style.color = "#10e5b2";
          setTimeout(() => {
            btn.textContent = original;
            (btn as HTMLElement).style.background = "";
            (btn as HTMLElement).style.color = "";
          }, 2000);
        });
      }
    });
  });
</script>

<style>
  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
    max-width: 960px;
    margin: 0 auto;
  }

  .download-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    position: relative;
  }

  .card-badge-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .platform-badge {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    letter-spacing: 0.05em;
  }

  .platform-blue {
    background: rgba(79, 139, 249, 0.15);
    color: var(--accent);
    border: 1px solid rgba(79, 139, 249, 0.4);
  }

  .platform-purple {
    background: rgba(157, 92, 255, 0.15);
    color: #c084fc;
    border: 1px solid rgba(157, 92, 255, 0.4);
  }

  .platform-teal {
    background: rgba(16, 229, 178, 0.15);
    color: var(--accent-2);
    border: 1px solid rgba(16, 229, 178, 0.4);
  }

  .status-pill {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(16, 229, 178, 0.15);
    color: var(--accent-2);
  }

  .status-arm {
    background: rgba(255, 189, 46, 0.15);
    color: #ffbd2e;
  }

  .download-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: transform 0.3s ease;
  }

  .download-card:hover .download-icon-wrap {
    transform: scale(1.08) translateY(-2px);
  }

