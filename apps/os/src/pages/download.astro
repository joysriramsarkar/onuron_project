---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import Hero from "@onuron/ui/components/Hero.astro";
---

<BaseLayout
  title="onuronOS Download — Not yet released (PLANNED)"
  description="onuronOS is not yet released. No physical device has been validated, no release images or checksums are published yet."
>
  <Navbar current="onuronOS" />

  <div class="ambient-glow ambient-blue" style="top: -80px; left: 10%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-purple" style="top: 250px; right: 5%;" aria-hidden="true"></div>

  <Hero
    title="onuronOS — Not yet released"
    subtitle="PLANNED — no physical device validated. onuronOS is a functional prototype developed and tested in QEMU (x86_64 / aarch64) only. There are no published fastboot images, simulator bundles, APKs, or SHA-256 checksums to download yet."
    eyebrow="✦ onuronOS · PLANNED · No physical device validated"
  >
    <a class="btn btn-primary btn-glow" href="#releases">
      <span>Release status</span>
    </a>
    <a class="btn btn-ghost" href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">
      <span>Ecosystem maturity doc ↗</span>
    </a>
  </Hero>

  <div class="divider"></div>

  <main style="position: relative; z-index: 1;">
    <section id="releases" class="section container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 56px auto;">
        <p class="section-eyebrow reveal">Release Status</p>
        <h2 class="anim-heading">Not yet released / PLANNED</h2>
        <p class="muted reveal" data-delay="1">
          Previous unverified SHA-256 hashes, package sizes and physical-device
          download claims have been removed: they were not backed by published,
          verifiable release artifacts. See the
          <a href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">ecosystem maturity doc</a>
          for the evidence-based status (no component is currently physical-device tested).
        </p>
      </div>

      <div class="downloads-grid gsap-stagger">
        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-blue">physical-device</span>
            <span class="status-pill status-arm">PLANNED</span>
          </div>
          <h3 class="download-title">Physical device images</h3>
          <p class="download-desc">
            Not yet released / PLANNED — no physical device validated. No fastboot
            ROM, boot/super/vbmeta image or device-specific build (for example
            OnePlus or Samsung handsets) has been published or tested on real
            hardware. Do not flash anything from this page.
          </p>
          <p class="muted small">
            Status source: <a href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">docs/ECOSYSTEM_MATURITY.md</a>
          </p>
        </div>

        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-purple">qemu-simulator</span>
            <span class="status-pill status-arm">PLANNED</span>
          </div>
          <h3 class="download-title">QEMU / simulator bundle</h3>
          <p class="download-desc">
            Not yet released / PLANNED — no physical device validated and no
            downloadable simulator bundle is published here. Development today is
            QEMU-based from source; see the maturity doc for what is actually
            verified in QEMU and what is not.
          </p>
          <p class="muted small">
            Status source: <a href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">docs/ECOSYSTEM_MATURITY.md</a>
          </p>
        </div>

        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-teal">android-host</span>
            <span class="status-pill status-arm">PLANNED</span>
          </div>
          <h3 class="download-title">Android host APK</h3>
          <p class="download-desc">
            Not yet released / PLANNED — no physical device validated and no host
            APK is published. Any future APK will be announced only with a
            verifiable checksum and signature produced at release time.
          </p>
          <p class="muted small">
            Status source: <a href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">docs/ECOSYSTEM_MATURITY.md</a>
          </p>
        </div>

        <div class="download-card glass-card motion-card">
          <div class="card-badge-top">
            <span class="platform-badge platform-purple">source-build</span>
            <span class="status-pill">SOURCE ONLY</span>
          </div>
          <h3 class="download-title">Source tree &amp; build tools</h3>
          <p class="download-desc">
            The source repository is the only currently available route. Building
            from source does not imply a released or physical-device-validated
            image. Checksums for release artifacts will be published only when a
            real release is built and signed.
          </p>
          <div class="download-action-group">
            <a class="btn btn-ghost download-btn" href="https://github.com/joysriramsarkar/onuronOS" target="_blank" rel="noreferrer">
              <span>GitHub repository ↗</span>
            </a>
          </div>
          <div class="hash-box">
            <div class="hash-label"><span>Quick Clone</span></div>
            <code class="hash-code">git clone https://github.com/joysriramsarkar/onuronOS.git</code>
          </div>
        </div>
      </div>
    </section>

    <section class="section-sm container" style="max-width: 860px;">
      <div class="glass-panel" style="padding: 36px 32px; border-radius: 20px;">
        <h3 style="margin: 0 0 16px; font-size: 1.5rem;">What is verified today?</h3>
        <p class="muted" style="line-height: 1.7; margin-bottom: 20px;">
          Per the maturity doc: onuronOS is a functional prototype validated in
          QEMU (x86_64 primary, aarch64 secondary). No component is currently
          physical-device tested, and GPU/audio/camera have no real backend
          (reported as not detected). Release claims will be updated only with
          reproducible evidence.
        </p>
        <a class="btn btn-primary small" href="https://github.com/joysriramsarkar/onuron_project/blob/main/docs/ECOSYSTEM_MATURITY.md">Read the maturity doc →</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
    max-width: 960px;
    margin: 0 auto;
  }
  .download-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    position: relative;
  }
  .card-badge-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .platform-badge {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    letter-spacing: 0.05em;
  }
  .platform-blue { background: rgba(79, 139, 249, 0.15); color: var(--accent); border: 1px solid rgba(79, 139, 249, 0.4); }
  .platform-purple { background: rgba(157, 92, 255, 0.15); color: #c084fc; border: 1px solid rgba(157, 92, 255, 0.4); }
  .platform-teal { background: rgba(16, 229, 178, 0.15); color: var(--accent-2); border: 1px solid rgba(16, 229, 178, 0.4); }
  .status-pill {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(16, 229, 178, 0.15);
    color: var(--accent-2);
  }
  .status-arm { background: rgba(255, 189, 46, 0.15); color: #ffbd2e; }
  .download-title { font-size: 1.6rem; margin: 0 0 10px 0; }
  .download-desc { color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin: 0 0 20px 0; }
  .download-action-group { margin-bottom: 20px; margin-top: auto; }
  .download-btn { width: 100%; justify-content: center; padding: 12px 18px; font-size: 0.96rem; gap: 8px; margin-bottom: 10px; }
  .hash-box { background: rgba(2, 4, 12, 0.85); border: 1px solid rgba(46, 64, 120, 0.45); border-radius: 12px; padding: 10px 14px; }
  .hash-label { display: flex; justify-content: space-between; align-items: center; font-size: 0.74rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
  .hash-code { font-size: 0.74rem; color: #94a3b8; word-break: break-all; line-height: 1.4; display: block; }
  :global([data-theme="light"]) .download-card { background: #ffffff !important; border-color: rgba(226, 232, 240, 0.95) !important; box-shadow: 0 6px 24px rgba(15, 23, 42, 0.06) !important; }
  :global([data-theme="light"]) .download-title { color: #0f172a !important; }
  :global([data-theme="light"]) .download-desc { color: #475569 !important; }
  :global([data-theme="light"]) .hash-box { background: #f1f5f9 !important; border-color: rgba(226, 232, 240, 0.95) !important; }
  :global([data-theme="light"]) .hash-code { color: #1e293b !important; }
</style>
