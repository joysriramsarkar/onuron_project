---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import Hero from "@onuron/ui/components/Hero.astro";
import FeatureCard from "@onuron/ui/components/FeatureCard.astro";
import StoreBadge from "@onuron/ui/components/StoreBadge.astro";
---

<BaseLayout title="onuronOS — সার্বভৌম ও উন্মুক্ত লিনাক্স মোবাইল অপারেটিং সিস্টেম">
  <Navbar current="onuronOS" />

  <Hero
    title="onuronOS"
    subtitle="স্মার্টফোনের জন্য ১০০% Rust-নির্মিত nilinit (PID 1), NilHAL টাচস্ক্রিন কম্পোজিটর, 120Hz ডিসপ্লে এবং কন্টেইনারাইজড অ্যান্ড্রয়েড কম্প্যাটিবিলিটি সহ সম্পূর্ণ স্বাধীন মোবাইল ওএস।"
    eyebrow="onuronOS Mobile v1.0 · Linux LTS · 100% Rust PID 1 nilinit"
  >
    <a class="btn btn-primary btn-glow" href="/download">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
        <line x1="12" y1="18" x2="12.01" y2="18"></line>
      </svg>
      মোবাইল ফাস্টবুট রিলিজ
    </a>
    <a class="btn btn-ghost" href="/features">মোবাইল ফিচারস →</a>
    <StoreBadge href="https://store.onuron.org" />
  </Hero>

  <!-- Divider -->
  <div class="divider"></div>

  <main>
    <!-- Stats -->
    <section class="section-sm container">
      <div class="stats-grid gsap-stagger">
        <div class="stat-item">
          <div class="stat-number" data-count="100" data-suffix="%">100%</div>
          <div class="stat-label">Rust-নির্মিত PID 1 Init</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="60" data-suffix=" FPS">60 FPS</div>
          <div class="stat-label">NilHAL ডিসপ্লে আউটপুট</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="6">6</div>
          <div class="stat-label">বিল্ট-ইন অ্যাপ স্যুট</div>
        </div>
        <div class="stat-item">
          <div class="stat-number" data-count="0">0</div>
          <div class="stat-label">টেলিমেট্রি · ট্র্যাকার</div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="section container spotlight-container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 64px auto;">
        <p class="section-eyebrow reveal">Architecture</p>
        <h2 class="anim-heading">পরবর্তী প্রজন্মের উন্মুক্ত আর্কিটেকচার</h2>
        <p class="muted reveal" data-delay="2">
          বিগ টেক-এর মনোপলি ভেঙে সম্পূর্ণ সার্বভৌম কম্পিউটিং অভিজ্ঞতা নিশ্চিত করতে onuronOS সাজানো হয়েছে আধুনিক টেক স্ট্যাক দিয়ে।
        </p>
      </div>

      <div class="grid gsap-stagger">
        <FeatureCard
          title="nilinit (Rust PID 1)"
          desc="মেমরি-নিরাপদ সিস্টেম ইনিশিয়ালাইজার — কয়েকশো মিলিসেকেন্ডে প্যারালাল বুট, সকেট অ্যাক্টিভেশন ও ডিক্লেয়ারেটিভ টার্গেট রেজিস্ট্রি।"
          icon="⚡"
          color="blue"
          href="/features#nilinit"
        />
        <FeatureCard
          title="NilHAL"
          desc="DRM/KMS ডিসপ্লে, লিনাক্স evdev মাল্টি-টাচ পাইপলাইন, ALSA লো-লেটেন্সি অডিও এবং পাওয়ার ম্যানেজমেন্ট।"
          icon="🔩"
          color="teal"
          href="/features#nilhal"
        />
        <FeatureCard
          title="Dual Android Bridge"
          desc="Track B (S25 NDK রানটাইম) ও Track C (Waydroid/AOSP কন্টেইনার) — উভয় ট্র্যাকে নির্বিঘ্নে অ্যান্ড্রয়েড অ্যাপস চালানো।"
          icon="🤝"
          color="purple"
          href="/features#android-bridge"
        />
        <FeatureCard
          title=".nilax App Store"
          desc="Ed25519 সাইনিং ও SHA-256 ইন্টিগ্রিটি যাচাইকৃত প্যাকেজ ফরম্যাট — জিরো ম্যালওয়্যার ও ব্লোটওয়্যার।"
          icon="📦"
          color="teal"
          href="https://store.onuron.org"
        />
        <FeatureCard
          title="NilLang + Alap UI"
          desc="নেটিভ রিঅ্যাক্টিভ ফ্রেমওয়ার্ক — মাখনের মতো মসৃণ 60 FPS ইউজার ইন্টারফেস ও কম্পোনেন্ট আর্কিটেকচার।"
          icon="🎨"
          color="purple"
          href="https://alap.onuron.org"
        />
        <FeatureCard
          title="nilos-emulator"
          desc="ভার্চুয়াল টাচস্ক্রিন ডিভাইসে অ্যাপ পরীক্ষা করার পূর্ণাঙ্গ `nilsim` স্টুডিও — হার্ডওয়্যার ছাড়াই।"
          icon="🖥️"
          color="blue"
          href="https://github.com/joysriramsarkar/nilos-emulator"
        />
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="section-sm container">
      <div class="cta-banner reveal-scale">
        <div class="cta-glow-1" aria-hidden="true"></div>
        <div class="cta-glow-2" aria-hidden="true"></div>
        <div class="cta-content">
          <p class="section-eyebrow" style="justify-content: center;">App Ecosystem</p>
          <h2>৬টি ফার্স্ট-পার্টি অ্যাপ প্রস্তুত</h2>
          <p class="muted">
            ক্যালকুলেটর, নোটপ্যাড, ফাইল ম্যানেজার, মিউজিক প্লেয়ার, টার্মিনাল এবং POS (দোকান খাতা) — সম্পূর্ণ বিজ্ঞাপণমুক্ত ও উন্মুক্ত।
          </p>
          <a class="btn btn-primary" href="https://store.onuron.org">App Store এক্সপ্লোর করুন →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .cta-banner {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(14,22,50,0.9) 0%, rgba(10,16,35,0.85) 100%);
    border: 1px solid rgba(79,139,249,0.3);
    border-radius: 28px;
    padding: 72px 48px;
    text-align: center;
    backdrop-filter: blur(20px);
  }
  .cta-glow-1, .cta-glow-2 {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .cta-glow-1 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(79,139,249,0.2) 0%, transparent 70%);
    top: -100px; left: -100px;
    animation: floatOrb 15s ease-in-out infinite;
  }
  .cta-glow-2 {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(157,92,255,0.15) 0%, transparent 70%);
    bottom: -80px; right: -80px;
    animation: floatOrb 18s ease-in-out infinite reverse;
  }
  .cta-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }
  .cta-content h2 { margin-bottom: 16px; }
  .cta-content p  { margin-bottom: 32px; }
  .cta-content .section-eyebrow { margin-bottom: 16px; }

  @keyframes floatOrb {
    0%, 100% { transform: translate(0,0); }
    50%       { transform: translate(20px, -20px); }
  }

  @media (max-width: 640px) {
    .cta-banner { padding: 48px 28px; }
  }
</style>
