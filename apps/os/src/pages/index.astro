---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import Hero from "@onuron/ui/components/Hero.astro";
import FeatureCard from "@onuron/ui/components/FeatureCard.astro";
import StoreBadge from "@onuron/ui/components/StoreBadge.astro";
---

<BaseLayout title="onuronOS — সার্বভৌম ও নিরাপদ মোবাইল এবং ডেস্কটপ অপারেটিং সিস্টেম">
  <Navbar current="onuronOS" />

  <Hero
    title="onuronOS"
    subtitle="স্মার্টফোন ও পার্সোনাল কম্পিউটারের জন্য সম্পূর্ণ স্বাধীন, মেমরি-নিরাপদ ও আধুনিক লিনাক্স-ভিত্তিক অপারেটিং সিস্টেম — নিজস্ব nilinit, NilHAL এবং বিল্ট-ইন App Store সহ।"
  >
    <a class="btn btn-primary" href="/download">Download System Image</a>
    <a class="btn btn-ghost" href="/features">এক্সপ্লোর করুন ফিচারসমূহ</a>
    <StoreBadge href="https://store.onuron.org" />
  </Hero>

  <main>
    <section class="section container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 36px auto;">
        <h2>পরবর্তী প্রজন্মের উন্মুক্ত অপারেটিং আর্কিটেকচার</h2>
        <p class="muted">
          বিগ টেক কোম্পানির মনোপলি ভেঙে সম্পূর্ণ সার্বভৌম ও স্বাধীন কম্পিউটিং অভিজ্ঞতা নিশ্চিত করতে onuronOS সাজানো হয়েছে আধুনিক প্রযুক্তি স্ট্যাক দিয়ে।
        </p>
      </div>

      <div class="grid">
        <FeatureCard
          title="nilinit (Rust PID 1)"
          desc="মেমরি-নিরাপদ ইনিশিয়ালাইজার — কোনো ক্র্যাশ বা ডেডলক ছাড়াই মিলি-সেকেন্ডে বুট ও প্যারালাল সার্ভিস লঞ্চ।"
        />
        <FeatureCard
          title="NilHAL & Multi-touch"
          desc="ডিভাইস-নিরপেক্ষ হার্ডওয়্যার লেয়ার — DRM/KMS ডিসপ্লে ও নিখুঁত লিনাক্স evdev ক্যাপাসিটিভ টাচ পাইপলাইন।"
        />
        <FeatureCard
          title="Dual Android Bridge"
          desc="S25 NDK-হস্টেড ফার্স্ট পার্টি রানটাইম এবং Waydroid কন্টেইনারের মাধ্যমে অ্যান্ড্রয়েড অ্যাপস ব্যবহারের সুবিধা।"
        />
        <FeatureCard
          title=".nilax App Store"
          desc="ক্রিপ্টোগ্রাফিক Ed25519 সাইনিং ও SHA-256 ইন্টিগ্রিটি যাচাইকৃত প্যাকেজ — জিরো ম্যালওয়্যার ঝুঁকি।"
        />
        <FeatureCard
          title="NilLang + Alap UI"
          desc="নেটিভ ডিক্লেয়ারেটিভ রিঅ্যাক্টিভ ফ্রেমওয়ার্ক — মাখনের মতো মসৃণ 60 FPS ইউজার ইন্টারফেস।"
        />
        <FeatureCard
          title="nilos-emulator (nilsim)"
          desc="হাতে ডিভাইস না থাকলেও ভার্চুয়াল ডিভাইসে যেকোনো অ্যাপ টেস্ট করার পূর্ণাঙ্গ ডেভেলপমেন্ট সিমুলেটর।"
        />
      </div>
    </section>

    <section class="section container" style="background: var(--bg-soft); border-radius: var(--radius); border: 1px solid var(--border); padding: 48px; margin-bottom: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px;">
        <div>
          <h2>অনুরণ অ্যাপ স্যুট ইতিমধ্যেই প্রস্তুত</h2>
          <p class="muted" style="margin: 0; max-width: 580px;">
            ক্যালকুলেটর, নোটপ্যাড, ফাইল ম্যানেজার, মিউজিক প্লেয়ার, টার্মিনাল এবং পয়েন্ট অব সেল (POS) — দৈনন্দিন জীবনের সমস্ত টুলস উন্মুক্ত ও বিজ্ঞাপণমুক্ত।
          </p>
        </div>
        <a class="btn btn-primary" href="https://store.onuron.org">App Store দেখুন →</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
