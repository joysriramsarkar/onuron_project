---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import { ECOSYSTEM_URLS } from "@onuron/ui/utils/links";
---

<BaseLayout title="Onuron — উন্মুক্ত কম্পিউটিং ইকোসিস্টেম">
  <Navbar current="Home" />

  <!-- Ambient Light Mesh -->
  <div class="ambient-glow ambient-blue" style="top: -100px; left: 15%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-purple" style="top: 150px; right: 5%;" aria-hidden="true"></div>
  <div class="ambient-glow ambient-teal" style="top: 600px; left: -50px;" aria-hidden="true"></div>

  <main style="position: relative; z-index: 1;">
    <!-- HERO SECTION -->
    <section class="hero-section">
      <!-- Interactive Constellation Canvas -->
      <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>

      <div class="container hero-content">
        <div class="shimmer-pill">
          <span class="pulse-dot"></span>
          <span>Onuron Ecosystem v1.0 • সম্পূর্ণ উন্মুক্ত কম্পিউটিং আর্কিটেকচার</span>
        </div>

        <h1 class="hero-title">
          সার্বভৌম মোবাইল কম্পিউটিংয়ের নতুন যুগ
          <span class="gradient-text hero-subtitle-gradient">onuronOS মোবাইল, nilLang ও alap-framework</span>
        </h1>

        <p class="hero-lead">
          <strong>onuronOS</strong> — স্মার্টফোনের জন্য 100% Rust-নির্মিত স্বাধীন মোবাইল অপারেটিং সিস্টেম (nilinit PID 1, NilHAL টাচস্ক্রিন কম্পোজিটর ও অ্যান্ড্রয়েড কম্প্যাটিবিলিটি), এবং এর সহযোগী <strong>nilLang</strong> ও <strong>alap-framework</strong>।
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary btn-glow" href={ECOSYSTEM_URLS.os}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
            onuronOS মোবাইল এক্সপ্লোর
          </a>

          <a class="btn btn-ghost glass-btn" href={ECOSYSTEM_URLS.store}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            App Store এক্সপ্লোর
          </a>

          <a class="btn btn-ghost" href="https://github.com/joysriramsarkar" target="_blank" rel="noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub ↗
          </a>
        </div>

        <!-- INTERACTIVE ECOSYSTEM TERMINAL / CODE INSPECTOR -->
        <div class="terminal-showcase glass-panel">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="terminal-tabs">
              <button class="tab-btn active" data-tab="nil">💎 main.nil</button>
              <button class="tab-btn" data-tab="alap">🎨 App.alap</button>
              <button class="tab-btn" data-tab="os">⚡ onuronOS.sh</button>
              <button class="tab-btn" data-tab="store">📦 store-api.json</button>
            </div>
            <div class="terminal-actions">
              <button id="run-demo-btn" class="run-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>রান করুন</span>
              </button>
            </div>
          </div>

          <div class="terminal-body">
            <!-- Code Tab 1: nilLang -->
            <pre class="code-tab-content active" id="tab-nil" is:raw><code><span class="code-keyword">import</span> { Window, Button, Label } <span class="code-keyword">from</span> <span class="code-string">"alap/ui"</span>
<span class="code-keyword">import</span> { Crypto, System } <span class="code-keyword">from</span> <span class="code-string">"onuron/core"</span>

<span class="code-keyword">fn</span> <span class="code-func">main</span>() {
    <span class="code-comment">// nilLang: মেমরি-নিরাপদ ও উচ্চ-গতিসম্পন্ন সিস্টেম ল্যাঙ্গুয়েজ</span>
    <span class="code-keyword">let</span> osInfo = System.version()
    <span class="code-func">print</span>(<span class="code-string">"🚀 Booting Onuron Ecosystem v"</span> + osInfo)

    <span class="code-keyword">let</span> hash = Crypto.sha256(<span class="code-string">"verified-package-payload"</span>)
    <span class="code-func">print</span>(<span class="code-string">"🔒 Integrity Hash: "</span> + hash.slice(0, 16) + <span class="code-string">"..."</span>)
}

main()</code></pre>

            <!-- Code Tab 2: alap-framework -->
            <pre class="code-tab-content" id="tab-alap" is:raw><code><span class="code-keyword">component</span> <span class="code-func">OnuronDashboard</span>() {
    <span class="code-keyword">state</span> appCount = 42
    <span class="code-keyword">state</span> status = <span class="code-string">"System Secure"</span>

    <span class="code-keyword">view</span> {
        &lt;<span class="code-keyword">Window</span> title=<span class="code-string">"onuronOS Control Center"</span> width={800}&gt;
            &lt;<span class="code-keyword">Header</span> icon=<span class="code-string">"◉"</span> label={status} /&gt;
            &lt;<span class="code-keyword">Button</span> onClick={() =&gt; appCount++}&gt;
                ইনস্টলকৃত প্যাকেজ: {appCount}
            &lt;/<span class="code-keyword">Button</span>&gt;
        &lt;/<span class="code-keyword">Window</span>&gt;
    }
}</code></pre>

            <!-- Code Tab 3: onuronOS -->
            <pre class="code-tab-content" id="tab-os" is:raw><code><span class="code-comment">#!/bin/sh</span>
<span class="code-comment"># onuronOS Microkernel Boot Sequence</span>
<span class="code-keyword">echo</span> <span class="code-string">"[onuronOS] Initializing microkernel memory isolation..."</span>
sysctl -w kernel.isolation=1
<span class="code-keyword">echo</span> <span class="code-string">"[onuronOS] Hardware capability verified: x86_64 / ed25519"</span>
<span class="code-keyword">echo</span> <span class="code-string">"[onuronOS] Starting verified App Store daemon..."</span>
onuron-store-daemon --port=4325 --verified-only &amp;
<span class="code-keyword">echo</span> <span class="code-string">"✓ Desktop environment ready in 0.84s"</span></code></pre>

            <!-- Code Tab 4: store-api.json -->
            <pre class="code-tab-content" id="tab-store" is:raw><code>{
  <span class="code-string">"version"</span>: <span class="code-string">"1.0.0"</span>,
  <span class="code-string">"registry"</span>: <span class="code-string">"https://store.onuron.org"</span>,
  <span class="code-string">"apps"</span>: [
    {
      <span class="code-string">"id"</span>: <span class="code-string">"org.onuron.notes"</span>,
      <span class="code-string">"name"</span>: <span class="code-string">"Onuron Notes"</span>,
      <span class="code-string">"version"</span>: <span class="code-string">"1.0.0"</span>,
      <span class="code-string">"verified"</span>: <span class="code-keyword">true</span>,
      <span class="code-string">"license"</span>: <span class="code-string">"MIT"</span>
    }
  ]
}</code></pre>
          </div>

          <!-- Interactive Simulator Console Output -->
          <div id="terminal-console" class="terminal-console">
            <div class="console-label">Console Output:</div>
            <div id="console-output" class="console-text">[সিস্টেম প্রস্তুত] "রান করুন" বাটনে ক্লিক করে লাইভ আউটপুট দেখুন...</div>
          </div>
        </div>
      </div>
    </section>

    <!-- KEY STATS SECTION -->
    <section class="container" style="margin-top: -30px; margin-bottom: 60px;">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number">১০০%</div>
          <div class="stat-label">উন্মুক্ত ও অডিটেবল সোর্স কোড</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">০</div>
          <div class="stat-label">টেলিমেট্রি, ট্র্যাকিং বা ব্লোটওয়্যার</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">&lt; ১.২s</div>
          <div class="stat-label">আল্ট্রাফাস্ট মাইক্রোকার্নেল বুট</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">ed25519</div>
          <div class="stat-label">ক্রিপ্টোগ্রাফিকালি সাইনড প্যাকেজ</div>
        </div>
      </div>
    </section>

    <!-- THE 3 PILLARS: 3D TILT CARDS -->
    <section class="section container">
      <div class="section-head">
        <span class="section-tag">THE 3 PILLARS</span>
        <h2 class="section-title">অনুরণ ইকোসিস্টেমের তিনটি মূল স্তম্ভ</h2>
        <p class="section-desc">অপারেটিং সিস্টেম থেকে প্রোগ্রামিং ভাষা এবং অ্যাপ ফ্রেমওয়ার্ক — প্রতিটি উপাদান একটির সাথে অপরটি নিখুঁতভাবে সমন্বিত।</p>
      </div>

      <div class="pillars-grid">
        <!-- Pillar 1: onuronOS -->
        <div class="motion-card tilt-card" data-tilt>
          <div class="pillar-icon pillar-icon-blue">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="pillar-badge">CORE MOBILE OPERATING SYSTEM</div>
          <h3 class="pillar-title">onuronOS</h3>
          <p class="pillar-desc">
            স্মার্টফোনের জন্য হালকা, নিরাপদ ও সম্পূর্ণ স্বাধীন লিনাক্স-ভিত্তিক মোবাইল ওএস। 100% Rust ইউজারস্পেস ও শূন্য গুগল ট্র্যাকিং।
          </p>
          <ul class="pillar-list">
            <li>✓ 100% Rust <code>nilinit</code> (PID 1) ও কয়েকশো মিলিসেকেন্ডে ফাস্ট বুট</li>
            <li>✓ DRM/KMS 120Hz/60Hz সরাসরি টাচস্ক্রিন কম্পোজিটর ও জেসচার</li>
            <li>✓ ডুয়েল অ্যান্ড্রয়েড ব্রিজ (Waydroid ও S25 NDK হোস্ট রানটাইম)</li>
          </ul>
          <a class="pillar-link" href={ECOSYSTEM_URLS.os}>
            <span>onuronOS ফিচারস ও আর্কিটেকচার</span>
            <span class="arrow">→</span>
          </a>
        </div>

        <!-- Pillar 2: nilLang -->
        <div class="motion-card tilt-card" data-tilt>
          <div class="pillar-icon pillar-icon-purple">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <div class="pillar-badge">SYSTEMS & APP LANGUAGE</div>
          <h3 class="pillar-title">nilLang</h3>
          <p class="pillar-desc">
            আধুনিক সিস্টেম এবং অ্যাপ্লিকেশন প্রোগ্রামিং ল্যাঙ্গুয়েজ। সহজ পাঠযোগ্য সিনট্যাক্স ও কম্পাইল-টাইম মেমরি সেফটি নিশ্চয়তা।
          </p>
          <ul class="pillar-list">
            <li>✓ কোনো গারবেজ কালেক্টর ওভারহেড ছাড়াই স্মৃতি নিরাপত্তা</li>
            <li>✓ নেটিভ বাইনারি এবং হাই-স্পিড WebAssembly কম্পাইলেশন</li>
            <li>✓ ব্রাউজারেই সরাসরি রান করার জন্য লাইভ ইন্টারঅ্যাক্টিভ প্লেগ্রাউন্ড</li>
          </ul>
          <a class="pillar-link" href={`${ECOSYSTEM_URLS.nil}/playground`}>
            <span>ব্রাউজার প্লেগ্রাউন্ড ট্রাই করুন</span>
            <span class="arrow">→</span>
          </a>
        </div>

        <!-- Pillar 3: alap-framework -->
        <div class="motion-card tilt-card" data-tilt>
          <div class="pillar-icon pillar-icon-teal">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="pillar-badge">APPLICATION FRAMEWORK</div>
          <h3 class="pillar-title">alap-framework</h3>
          <p class="pillar-desc">
            অনুরণ প্ল্যাটফর্মে দ্রুত, আধুনিক এবং প্রতিক্রিয়াশীল (Reactive) ডেস্কটপ ও ইউটিলিটি অ্যাপ তৈরির জন্য শক্তিশালী ফ্রেমওয়ার্ক।
          </p>
          <ul class="pillar-list">
            <li>✓ ডিক্লোরেটিভ কম্পোনেন্ট আর্কিটেকচার ও স্টেট ম্যানেজমেন্ট</li>
            <li>✓ হার্ডওয়্যার-অ্যাক্সিলারেটেড 60+ FPS স্মুথ ইউআই রেন্ডারিং</li>
            <li>✓ nilLang এর সাথে মসৃণ নেটিভ বাইন্ডিং ও প্যাকেজিং</li>
          </ul>
          <a class="pillar-link" href={ECOSYSTEM_URLS.alap}>
            <span>alap কুইকস্টার্ট গাইড</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE STACK VISUALIZER -->
    <section class="section container">
      <div class="section-head">
        <span class="section-tag">SYSTEM ARCHITECTURE</span>
        <h2 class="section-title">পূর্ণাঙ্গ সার্বভৌম আর্কিটেকচার</h2>
        <p class="section-desc">হার্ডওয়্যার লেয়ার থেকে শুরু করে অ্যাপ্লিকেশন স্টোরফ্রন্ট পর্যন্ত অনুরুণ কীভাবে কাজ করে:</p>
      </div>

      <div class="arch-stack glass-panel">
        <div class="arch-layer" data-layer="store">
          <div class="arch-badge">LAYER 5</div>
          <div class="arch-info">
            <h4>Onuron Mobile Store & Verified Registry</h4>
            <p>Git-চালিত উন্মুক্ত মোবাইল রেজিস্ট্রি ও ক্রিপ্টোগ্রাফিকালি ভেরিফাইড <code>.nilax</code> প্যাকেজ ফিড।</p>
          </div>
          <div class="arch-tag">store.onuron.org</div>
        </div>

        <div class="arch-connector"></div>

        <div class="arch-layer" data-layer="alap">
          <div class="arch-badge">LAYER 4</div>
          <div class="arch-info">
            <h4>alap-framework (Mobile UI & Runtime Engine)</h4>
            <p>টাচস্ক্রিন জেসচার, রিঅ্যাক্টিভ মোবাইল উইজেট এবং 120Hz গ্লাস-ইউআই রেন্ডারার।</p>
          </div>
          <div class="arch-tag">alap.onuron.org</div>
        </div>

        <div class="arch-connector"></div>

        <div class="arch-layer" data-layer="nil">
          <div class="arch-badge">LAYER 3</div>
          <div class="arch-info">
            <h4>nilLang Native Systems Engine & VM</h4>
            <p>জিরো-কস্ট অ্যাবস্ট্রাকশন, মেমরি সেফটি ও দ্রুত কম্পাইলেশন ল্যাঙ্গুয়েজ ও রানটাইম।</p>
          </div>
          <div class="arch-tag">nil.onuron.org</div>
        </div>

        <div class="arch-connector"></div>

        <div class="arch-layer" data-layer="os">
          <div class="arch-badge">LAYER 2</div>
          <div class="arch-info">
            <h4>onuronOS Mobile Microkernel & Rust PID 1 nilinit</h4>
            <p>100% Rust PID 1, NilHAL টাচস্ক্রিন/অডিও লেয়ার ও কন্টেইনারাইজড অ্যান্ড্রয়েড কম্প্যাটিবিলিটি।</p>
          </div>
          <div class="arch-tag">os.onuron.org</div>
        </div>

        <div class="arch-connector"></div>

        <div class="arch-layer arch-layer-hardware" data-layer="hw">
          <div class="arch-badge">LAYER 1</div>
          <div class="arch-info">
            <h4>Mobile Hardware & Device Tree (DTB)</h4>
            <p>OnePlus 6T (Snapdragon 845), Galaxy S25 Hosted Lab, এবং QEMU ARM64/x86_64 টাচ সিমুলেটর।</p>
          </div>
          <div class="arch-tag">Mobile Target</div>
        </div>
      </div>
    </section>

    <!-- DEVELOPER CLI INTERACTIVE SNIPPET -->
    <section class="section container" style="text-align: center;">
      <div class="cli-box glass-panel">
        <span class="section-tag" style="margin-bottom: 12px;">QUICK INSTALL</span>
        <h3 style="margin: 0 0 12px; font-size: 1.8rem;">ডেভেলপমেন্ট শুরু করুন মাত্র এক কমান্ডে</h3>
        <p class="muted" style="max-width: 580px; margin: 0 auto 24px;">
          onuronOS টুলচেইন, nilLang কম্পাইলার এবং alap-framework সিএলআই একত্রে ইনস্টল করুন:
