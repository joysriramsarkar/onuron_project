<!-- SCRIPT: INTERACTIVE PARTICLES CANVAS & INTERACTIVE TERMINAL -->
<script>
  // 1. Interactive Constellation Canvas in Hero
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width = (canvas.width = canvas.parentElement?.offsetWidth || window.innerWidth);
    let height = (canvas.height = canvas.parentElement?.offsetHeight || 600);

    window.addEventListener("resize", () => {
      if (!canvas || !canvas.parentElement) return;
      width = canvas.width = canvas.parentElement.offsetWidth;
      height = canvas.height = canvas.parentElement.offsetHeight;
    });

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
    }

    const particles: Particle[] = [];
    const count = Math.min(45, Math.floor(width / 25));

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        radius: Math.random() * 2 + 1,
      });
    }

    let mouse = { x: -1000, y: -1000 };
    window.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        // Interaction with mouse
        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 120) {
          p.x -= (dx / dist) * 0.8;
          p.y -= (dy / dist) * 0.8;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(147, 197, 253, 0.45)";
        ctx.fill();

        // Connect lines
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist2 = Math.hypot(p.x - p2.x, p.y - p2.y);
          if (dist2 < 110) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(79, 139, 249, ${0.2 * (1 - dist2 / 110)})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    }
    draw();
  }

  // 2. Interactive Terminal Tab Switching
  const tabs = document.querySelectorAll(".tab-btn");
  const tabContents = document.querySelectorAll(".code-tab-content");
  const consoleOutput = document.getElementById("console-output");

  const outputs: Record<string, string> = {
    nil: "🚀 Booting Onuron Ecosystem v1.0\n🔒 Integrity Hash: 9e107d9d372bb682...\n[Process exited with status 0]",
    alap: "✓ onuronOS Control Center rendered at 60 FPS\n✓ State synced: appCount = 42, status = 'System Secure'",
    os: "[onuronOS] Hardware verified: x86_64\n[onuronOS] App Store daemon active on :4325\n✓ Desktop ready in 0.84s",
    store: "HTTP/1.1 200 OK - Feed verified\n✓ ed25519 signature valid for org.onuron.notes",
  };

  let activeTab = "nil";

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.classList.remove("active"));
      tabContents.forEach((c) => c.classList.remove("active"));

      tab.classList.add("active");
      const target = tab.getAttribute("data-tab");
      if (target) {
        activeTab = target;
        const targetContent = document.getElementById(`tab-${target}`);
        if (targetContent) targetContent.classList.add("active");

        if (consoleOutput) {
          consoleOutput.textContent = `[সিস্টেম সুইচ: ${target}] "রান করুন" বাটনে ক্লিক করুন...`;
        }
      }
    });
  });

  // Run Demo Button
  const runBtn = document.getElementById("run-demo-btn");
  if (runBtn && consoleOutput) {
    runBtn.addEventListener("click", () => {
      consoleOutput.innerHTML = `<span style="color: #60a5fa;">▶ কম্পাইলিং ও সিমুলেশন চলছে...</span>`;
      setTimeout(() => {
        const text = outputs[activeTab] || "Execution completed successfully.";
        consoleOutput.textContent = text;
      }, 350);
    });
  }

  // Copy CLI command button
  const copyBtn = document.getElementById("copy-cli-btn");
  const copyFeedback = document.getElementById("copy-feedback");
  if (copyBtn && copyFeedback) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText("curl -fsSL https://get.onuron.org | sh");
      copyFeedback.textContent = "কপি হয়েছে!";
      copyFeedback.style.color = "#10e5b2";
      setTimeout(() => {
        copyFeedback.textContent = "কপি";
        copyFeedback.style.color = "inherit";
      }, 2000);
    });
  }

  // 3. 3D Tilt Cards effect on Mousemove
  const tiltCards = document.querySelectorAll(".tilt-card");
  tiltCards.forEach((card) => {
    card.addEventListener("mousemove", (e: Event) => {
      const mouseEvent = e as MouseEvent;
      const htmlCard = card as HTMLElement;
      const rect = htmlCard.getBoundingClientRect();
      const x = mouseEvent.clientX - rect.left;
      const y = mouseEvent.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -7;
      const rotateY = ((x - centerX) / centerX) * 7;

      htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
    });

    card.addEventListener("mouseleave", () => {
      const htmlCard = card as HTMLElement;
      htmlCard.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)";
    });
  });
</script>
