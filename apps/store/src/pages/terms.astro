---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
---

<BaseLayout title="Terms of Service — onuronOS App Store">
  <Navbar current="App Store" />
  <main class="container prose section">
    <h1>App Store Terms of Service</h1>
    <p>
      onuronOS App Store প্ল্যাটফর্ম ব্যবহারের ক্ষেত্রে এই শর্তাবলী প্রযোজ্য।
    </p>

    <h2>ডিস্ট্রিবিউশন প্ল্যাটফর্ম হিসেবে ভূমিকা</h2>
    <p>
      Onuron প্ল্যাটফর্ম ডেভেলপারদের অ্যাপ প্রদর্শনের একটি উন্মুক্ত মাধ্যম।
      তৃতীয় পক্ষের অ্যাপের কার্যকারিতা, সিকিউরিটি বা কন্টেন্টের সম্পূর্ণ দায় সংশ্লিষ্ট ডেভেলপারের।
    </p>

    <h2>সফটওয়্যার লাইসেন্সিং</h2>
    <p>
      প্রতিটি অ্যাপের ডিটেইলস পেজে তার নির্দিষ্ট লাইসেন্স প্রদর্শিত থাকে (যেমন MIT, Apache, GPL)।
      ব্যবহারকারীকে সংশ্লিষ্ট সফটওয়্যার লাইসেন্স মেনে তা ব্যবহারের জন্য অনুরোধ করা হচ্ছে।
    </p>

    <h2>শর্ত পরিবর্তন</h2>
    <p>
      ইকোসিস্টেমের প্রয়োজনে এই নীতিমালা সময়ে সময়ে হালনাগাদ হতে পারে।
    </p>
  </main>
  <Footer />
</BaseLayout>
