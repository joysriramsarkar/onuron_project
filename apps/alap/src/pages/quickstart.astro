---
import BaseLayout from "@onuron/ui/components/BaseLayout.astro";
import Navbar from "@onuron/ui/components/Navbar.astro";
import Footer from "@onuron/ui/components/Footer.astro";
import CodeBlock from "@onuron/ui/components/CodeBlock.astro";
---

<BaseLayout title="Quick Start — alap-framework">
  <Navbar current="alap" />
  <main class="container prose section">
    <h1>Quick Start Guide</h1>
    <p>
      alap-framework দিয়ে মাত্র ২ মিনিটে আপনার প্রথম ফুল-স্ট্যাক ওয়েব বা ডেস্কটপ অ্যাপ্লিকেশন তৈরি করুন।
    </p>

    <h2>১. নতুন ওয়েব প্রজেক্ট তৈরি করুন</h2>
    <CodeBlock label="$" code="nil init my-web-app --profile web && cd my-web-app" />

    <h2>২. প্রজেক্ট কনফিগারেশন (alap.yaml)</h2>
    <CodeBlock code={`name: my-web-app
version: 1.0.0
type: web

entry:
  server: src/server.nil
  client: src/client.nil

web:
  ssr: true
  hydration: true
  radix_routing: true

database:
  driver: postgres`} />

    <h2>৩. লাইভ ডেভেলপমেন্ট সার্ভার চালু করুন</h2>
    <CodeBlock label="$" code="nil dev --port 8080" />
    <p>
      ব্রাউজারে ভিজিট করুন: <code class="mono">http://localhost:8080</code> — হট-রিলোড ও Radix Tree রাউটার স্বয়ংক্রিয়ভাবে সক্রিয় হবে।
    </p>

    <h2>৪. ডেটাবেস স্কিমা মাইগ্রেশন</h2>
    <CodeBlock label="$" code="nil db migrate" />

    <h2>৫. প্রোডাকশন ওয়েব ও নেটিভ বান্ডেল বিল্ড</h2>
    <CodeBlock label="$" code="nil build wasm          # WebAssembly ও ক্লায়েন্ট রানটাইম" />
    <CodeBlock label="$" code="alap build --package onp # onuronOS অ্যাপ স্টোর প্যাকেজ" />
  </main>
  <Footer />
</BaseLayout>
