{
  "name": "onuron-monorepo",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm validate && pnpm --filter @onuron/store-schema lint",
    "validate": "pnpm --filter @onuron/store-schema validate",
    "validate:verify": "pnpm --filter @onuron/store-schema validate:verify",
    "contracts:check": "pnpm --filter @onuron/store-schema contracts:check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
