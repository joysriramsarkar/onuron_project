---
import { ECOSYSTEM_URLS } from "../utils/links";

export interface Props {
  href?: string;
}

const { href = ECOSYSTEM_URLS.store } = Astro.props;
---

<a class="store-badge" href={href}>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
    <rect x="3" y="3" width="18" height="18" rx="5" stroke="#5b8cff" stroke-width="2" />
    <path
      d="M12 8v6m0 0l-3-3m3 3l3-3M8 17h8"
      stroke="#22d3aa"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span>
    <small>Get it on</small>
    <strong>onuronOS App Store</strong>
  </span>
</a>
